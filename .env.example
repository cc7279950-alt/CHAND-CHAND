# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Cryptographic secret for signing authentication tokens (set a strong random string in production).
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"

# ADMIN_BOOTSTRAP_EMAIL: Optional initial admin account email seeded on first run.
ADMIN_BOOTSTRAP_EMAIL="admin@chandmotors.pk"

# ADMIN_BOOTSTRAP_PASSWORD: Optional initial admin password seeded on first run (never reuse in production).
ADMIN_BOOTSTRAP_PASSWORD="ChandAdmin!2026"

# NOTIFY_EMAIL: Owner email address that receives sign-in and registration alerts.
NOTIFY_EMAIL="cc7279950@gmail.com"

# Email / SMTP Configuration for Sign-In Notifications
# Option A (Gmail App Password): Set GMAIL_USER and GMAIL_APP_PASSWORD in AI Studio Secrets.
GMAIL_USER="cc7279950@gmail.com"
GMAIL_APP_PASSWORD=""

# Option B (Custom SMTP Server): Override host, port, user, and pass if not using Gmail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CHAND MOTORS <cc7279950@gmail.com>"
